# Copy locally to deploy/.env. Never commit, print, or attach the filled file.
POSTGRES_PASSWORD=
AUTOEXPERT_DATABASE_URL=postgresql+psycopg://autoexpert:URL_ENCODED_PASSWORD@db:5432/autoexpert
AUTOEXPERT_SECRET_KEY=
AUTOEXPERT_CORS_ORIGINS=["http://localhost:8088","https://appassets.autoexpert.local"]
AUTOEXPERT_SITE=:80
AUTOEXPERT_KNOWLEDGE_WORKER_ENABLED=true
# Provider secrets stay here only when separately authorized. None are required to browse.
