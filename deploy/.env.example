# /srv/autoexpert/shared/.env on the server (chmod 600, never in git). Names only here; the values
# are generated on the laptop by deploy/make_secrets.py and kept outside git.

# PostgreSQL
POSTGRES_DB=autoexpert
POSTGRES_USER=autoexpert
POSTGRES_PASSWORD=

# Backend: production security with the new features switched on (closed staging)
AUTOEXPERT_ENVIRONMENT=production
AUTOEXPERT_SECRET_KEY=
AUTOEXPERT_DEVELOPER_MODE=false
AUTOEXPERT_DEMO_MODE=false
AUTOEXPERT_SEED_DEMO_ON_START=false
AUTOEXPERT_SHOW_US_TECH_FACTS=true
AUTOEXPERT_GARAGE_V1=true
AUTOEXPERT_AI_MECHANIC_V1=true
AUTOEXPERT_OWNERS_CLUB_V1=true
AUTOEXPERT_PUBLIC_CAR_PAGES=true
AUTOEXPERT_SUBSCRIPTION_V1=true
AUTOEXPERT_GARAGE_RECALL_JOB=false
AUTOEXPERT_CORS_ORIGINS=["http://77.42.27.222"]
AUTOEXPERT_PUBLIC_APP_URL=http://77.42.27.222/preview/
AUTOEXPERT_PUBLIC_SITE_BASE_URL=http://77.42.27.222

# Keys (none yet: every feature works in its keyless mode)
AUTOEXPERT_ANTHROPIC_API_KEY=

# Caddy: ":80" until there is a domain; then the domain name (HTTPS automatically)
SITE_ADDRESS=:80
BASIC_AUTH_USER=
BASIC_AUTH_HASH=

# Copies of the daily backup outside the server: none / storagebox / s3
BACKUP_OFFSITE=none
STORAGEBOX_USER=
STORAGEBOX_HOST=
STORAGEBOX_PATH=autoexpert-backups
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
