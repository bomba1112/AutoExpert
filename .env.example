AUTOEXPERT_ENVIRONMENT=development
AUTOEXPERT_DATABASE_URL=sqlite:///./autoexpert.db
AUTOEXPERT_SECRET_KEY=replace-with-at-least-32-random-characters
AUTOEXPERT_ACCESS_TOKEN_MINUTES=60
AUTOEXPERT_ADMIN_EMAIL=admin@example.invalid
AUTOEXPERT_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","https://appassets.autoexpert.local"]
AUTOEXPERT_LLM_PROVIDER=deterministic
AUTOEXPERT_PAYMENT_PROVIDER=mock
AUTOEXPERT_FULL_REPORT_PRICE_AZ_AZN=2.99
AUTOEXPERT_COMPARE_REPORT_PRICE_AZ_AZN=6.99
AUTOEXPERT_MODEL_DOSSIER_PRICE_AZ_AZN=2.99
AUTOEXPERT_VIN_CHECK_1_PRICE_AZ_AZN=5.00
AUTOEXPERT_VIN_CHECK_3_PRICE_AZ_AZN=11.99
AUTOEXPERT_CHAT_ACCESS_MODE=INCLUDED_WITH_UNLOCKED_DOSSIER
AUTOEXPERT_CHAT_QUESTION_LIMIT=10
AUTOEXPERT_CHAT_DEMO_UNLIMITED=true
AUTOEXPERT_DEMO_MODE=true
AUTOEXPERT_DEVELOPER_MODE=true
AUTOEXPERT_DEVELOPER_SIMULATE_USER_PAYWALL_DEFAULT=false
